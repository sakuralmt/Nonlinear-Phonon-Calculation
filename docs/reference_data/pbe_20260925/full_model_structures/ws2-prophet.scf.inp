&CONTROL
  calculation = 'scf'
  disk_io = 'low'
  prefix = 'pwscf'
  pseudo_dir = '../pseudos'
  outdir = './tmp'
  verbosity = 'low'
  tprnfor = .false.
  tstress = .false.
  forc_conv_thr = 1.0d-8
  etot_conv_thr = 1.0d-10
/

&SYSTEM
  ibrav = 0
  nat = 3, ntyp = 2
  occupations = 'smearing', smearing = 'gauss', degauss = 1.0d-10
  ecutwfc = 120, ecutrho = 1200
/

&ELECTRONS
  electron_maxstep = 10000
  conv_thr = 1.0d-12
  mixing_mode = 'plain'
  mixing_beta = 0.3d0
  diagonalization = 'david'
/

ATOMIC_SPECIES
W  183.840000 W.pz-spn-rrkjus_psl.1.0.0.UPF
S  32.060000 S.pz-n-rrkjus_psl.0.1.UPF

CELL_PARAMETERS angstrom
  3.192284372851951  -0.000000000000000  0.000000000000000
  -1.596142186425975  2.764599362930553  0.000000000000000
  0.000000000000000  -0.000000000000000  18.090841669000000

ATOMIC_POSITIONS crystal
