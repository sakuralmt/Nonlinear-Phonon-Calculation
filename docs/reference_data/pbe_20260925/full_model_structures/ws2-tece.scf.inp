&CONTROL
  calculation = 'scf'
  disk_io = 'low'
  prefix = 'pwscf'
  pseudo_dir = '../pseudos'
  outdir = './tmp'
  verbosity = 'low'
  tprnfor = .false.
  tstress = .false.
  forc_conv_thr = 1.0d-8
  etot_conv_thr = 1.0d-10
/

&SYSTEM
  ibrav = 0
  nat = 3, ntyp = 2
  occupations = 'smearing', smearing = 'gauss', degauss = 1.0d-10
  ecutwfc = 120, ecutrho = 1200
/

&ELECTRONS
  electron_maxstep = 10000
  conv_thr = 1.0d-12
  mixing_mode = 'plain'
  mixing_beta = 0.3d0
  diagonalization = 'david'
/

ATOMIC_SPECIES
W  183.840000 W.pz-spn-rrkjus_psl.1.0.0.UPF
S  32.060000 S.pz-n-rrkjus_psl.0.1.UPF

CELL_PARAMETERS angstrom
  3.191568046549940  -0.000000000000000  0.000000000000000
  -1.595784023274970  2.763979006155627  0.000000000000000
  0.000000000000000  -0.000000000000000  18.090841669000000

ATOMIC_POSITIONS crystal
W  0.000000000000000  0.000000000000000  0.500000000000000  0 0 0
S  0.666666666700000  0.333333333300000  0.586895126670173  0 0 1
S  0.666666666700000  0.333333333300000  0.413104868515368  0 0 1

