&CONTROL
calculation='scf'
disk_io='low'
prefix='pwscf'
pseudo_dir='./'
outdir='./tmp'
verbosity='high'
tprnfor=.true.
tstress=.true.
forc_conv_thr=1.0d-8
etot_conv_thr=1.0d-10
/

&SYSTEM
ibrav=0
nat=3,ntyp=2
occupations='smearing', smearing='gauss', degauss=1.0d-10
ecutwfc=80, ecutrho=800
/

&ELECTRONS
electron_maxstep=10000
conv_thr=1.0d-10
mixing_mode='plain'
mixing_beta=0.3d0
diagonalization='david'
/

&IONS
ion_dynamics='bfgs'
/

&CELL
press_conv_thr=0.1
/

ATOMIC_SPECIES
W  183.84 W.pz-spn-rrkjus_psl.1.0.0.UPF
Se 78.960 Se.pz-n-rrkjus_psl.0.2.UPF 

